<Window x:Class="LibrarySimple.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книга" Height="250" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Margin="100,0,0,0" Width="250"/>

        <TextBlock Text="Автор:" Grid.Row="2"/>
        <ComboBox x:Name="AuthorBox" Grid.Row="2" Margin="100,0,0,0" Width="250"/>

        <TextBlock Text="Жанр:" Grid.Row="4"/>
        <ComboBox x:Name="GenreBox" Grid.Row="4" Margin="100,0,0,0" Width="250"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ОК" Width="80" Margin="0,0,10,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>